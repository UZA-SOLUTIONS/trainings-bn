PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173,https://trainings-fn.vercel.app,https://trainings.uzamobility.com
JWT_SECRET=change-me-to-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=1h

# Password for default seed staff (admin@uza.rw, instructor@uza.rw, partner@unguka.rw)
SEED_STAFF_PASSWORD=ChangeMe123!

# MongoDB — local or Atlas. On Vercel you MUST use Atlas (or another hosted MongoDB).
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
MONGODB_URI=mongodb://127.0.0.1:27017/uza_mobility
# Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uza_mobility?retryWrites=true&w=majority
# If npm start fails with "tlsv1 alert internal error", add your public IP in Atlas → Network Access.
# For Vercel: Atlas → Network Access → allow 0.0.0.0/0 (or Vercel's egress IPs).
