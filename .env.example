PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h

# Password for default seed staff (admin@uza.rw, instructor@uza.rw, partner@unguka.rw)
SEED_STAFF_PASSWORD=ChangeMe123!

# MongoDB — local or Atlas. Prefer MONGODB_URI for the app.
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
MONGODB_URI=mongodb://127.0.0.1:27017/uza_mobility
# Atlas (Windows: use standard shard URI, not mongodb+srv — SRV DNS often fails locally):
# MONGODB_URI=mongodb://USER:PASSWORD@host-shard-00-00....mongodb.net:27017,host-shard-00-01....mongodb.net:27017,host-shard-00-02....mongodb.net:27017/uza_mobility?ssl=true&replicaSet=YOUR-REPLICA-SET&authSource=admin&retryWrites=true&w=majority
# If npm start fails with "tlsv1 alert internal error", add your public IP in Atlas → Network Access.
